# EduSpark — production environment template
# Copy this to .env on your VPS (next to docker-compose.yml) and fill in real values.
# Never commit your real .env file. The .gitignore already excludes it.

# ─── Database ────────────────────────────────────────────────────
POSTGRES_USER=eduspark
POSTGRES_PASSWORD=replace_with_a_long_random_string
POSTGRES_DB=eduspark
# Optional — uncomment the ports block in docker-compose.yml if you need it
# POSTGRES_PORT=5437

# ─── App ─────────────────────────────────────────────────────────
# Sign JWTs with this. MUST be a long random string. Rotate compromises invalidate every token.
JWT_SECRET=replace_with_a_long_random_string_minimum_64_chars

# Public host port the frontend listens on (your reverse proxy / browsers hit this)
# Avoids conflict with other VPS containers on 3000 / 3001 / 3004
APP_PORT=3007

# CORS origin for the API. Set to your public origin once you wire a domain.
# Use "*" only while testing without a domain.
CORS_ORIGIN=https://eduspark.yourdomain.com

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      Role     @default(STUDENT)
  pin       String?  @unique
  grade     Int?
  xp        Int      @default(0)
  active    Boolean  @default(true)
  photo     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // For tutors: subjects and grades they teach (used for student pairing recommendations)
  subjects    String[]
  teachGrades Int[]

  // For students: whether tutor has unlocked exam readiness view
  examReadinessUnlocked Boolean @default(false)

  // ─── PIN recovery (Phase 8) ──────────────────────────────────
  // Both fields are optional so existing users keep working until they opt in.
  // securityAnswerHash stores a bcrypt hash — answers are never stored plain text.
  securityQuestion    String?
  securityAnswerHash  String?

  // For students: which tutor manages them
  teacherId String?
  teacher   User?   @relation("TutorStudents", fields: [teacherId], references: [id])
  students  User[]  @relation("TutorStudents")

  results            QuizResult[]
  createdNotes       CalendarNote[]
  createdAssignments Assignment[]
  createdQuestions   Question[]
  calendarRequests   CalendarRequest[] @relation("CalendarRequests")
  parentAccesses     ParentAccess[]    @relation("ParentAccess")
  tutorRequests      TutorRequest[]    @relation("TutorRequests")
  studentRequests    TutorRequest[]    @relation("StudentRequests")

  // Phase 7: calendar scoping
  tutorCalendarNotes   CalendarNote[]  @relation("TutorCalendarNotes")
  studentCalendarNotes CalendarNote[]  @relation("StudentCalendarNotes")

  // Phase 1-5 additions
  createdPacks       Pack[]            @relation("PackCreator")
  packShares         PackShare[]       @relation("TutorShares")
  sharesGiven        PackShare[]       @relation("PackSharedBy")
  studentUnlocks     StudentUnlock[]   @relation("StudentUnlocks")
  unlocksGiven       StudentUnlock[]   @relation("UnlockedBy")
  uploadedDocs       PdfDocument[]     @relation("DocumentUploader")
  notifications      Notification[]    @relation("Notifications")
  onboarding         OnboardingState?  @relation("Onboarding")

  // Phase 9
  generationBatches  QuestionBatch[]   @relation("BatchCreator")
  auditTrail         AuditLog[]        @relation("AuditActor")

  // v2.9 — questions this user has reviewed/approved
  reviewedQuestions  Question[]        @relation("QuestionReviewer")

  @@map("users")
}

model Question {
  id         String     @id @default(cuid())
  subject    Subject
  grade      Int
  topic      String
  difficulty Difficulty @default(EASY)
  question   String     @db.Text
  options    String[]
  answer     String
  solution   String?    @db.Text
  visibility Visibility @default(ALL)
  imageData  String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // ─── Quality / review pipeline (v2.9) ─────────────────────────────
  // status        : DRAFT → REVIEW → PUBLISHED (only PUBLISHED reaches packs) → RETIRED
  // capsCode      : CAPS curriculum reference, e.g. "10.2.1" — lets stats slice by curriculum
  // cognitiveLevel: CAPS cognitive level 1-4 (Knowledge · Routine · Complex · Problem-solving)
  // qualityFlag   : auto-computed health flag — null = healthy, else 'broken'|'trivial'|'low_discrimination'|'no_attempts'
  // validationErrors: blocking issues found by the validation pipeline (empty = clean)
  status           QuestionStatus @default(DRAFT)
  capsCode         String?
  cognitiveLevel   Int?
  qualityFlag      String?
  validationErrors String[]
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?          @relation("QuestionReviewer", fields: [reviewedById], references: [id])

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  assignmentQuestions AssignmentQuestion[]
  resultDetails       ResultDetail[]
  packQuestions       PackQuestion[]
  batchItems          QuestionBatchItem[] @relation("BatchedQuestions")

  @@index([status, subject, grade])
  @@index([qualityFlag])
  @@map("questions")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  subject     Subject
  grade       Int
  topic       String
  dueDate     DateTime
  assignTo    String   @default("all")
  maxAttempts Int      @default(3)
  tutorId     String?  // null = global (admin-created); set = scoped to this tutor's students
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  questions  AssignmentQuestion[]
  documents  AssignmentDocument[]
  results    QuizResult[]

  @@map("assignments")
}

model AssignmentQuestion {
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String
  order        Int        @default(0)

  @@id([assignmentId, questionId])
  @@map("assignment_questions")
}

model AssignmentDocument {
  id           String     @id @default(cuid())
  title        String
  content      String?    @db.Text
  imageData    String?    @db.Text
  documentType String     @default("text")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String

  @@map("assignment_documents")
}

model QuizResult {
  id            String     @id @default(cuid())
  score         Int
  correct       Int
  total         Int
  timeTaken     Int        @default(0)
  xpEarned      Int        @default(0)
  attemptNumber Int        @default(1)
  resultType    ResultType @default(ASSIGNMENT)
  practiceTopic   String?
  practiceSubject String?
  completedAt   DateTime   @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?

  details ResultDetail[]

  @@map("quiz_results")
}

model ResultDetail {
  id             String  @id @default(cuid())
  questionText   String  @db.Text
  selectedAnswer String?
  correctAnswer  String
  isCorrect      Boolean
  solution       String? @db.Text
  difficulty     String  @default("Easy")
  imageData      String? @db.Text

  result     QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId   String
  question   Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionId String?

  @@map("result_details")
}

model CalendarNote {
  id        String   @id @default(cuid())
  date      String
  title     String
  content   String?  @db.Text
  color     String   @default("note")
  createdAt DateTime @default(now())

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  // ─── Scoping (Phase 7) ─────────────────────────────────────────
  // tutorId  : owner if note was created by a tutor (null = admin/global note)
  // studentId: if set, scoped to this single student; if null, broadcast to
  //            the whole class of that tutor (or all students if admin)
  // kind     : 'class' (regular event) | 'session' (tutoring session)
  //            | 'maintenance' (visible to admin) | 'broadcast' (admin → everyone)
  // sharedWithAdmin: tutor flag to surface this note in admin's calendar
  tutorId         String?
  tutor           User?   @relation("TutorCalendarNotes", fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       String?
  student         User?   @relation("StudentCalendarNotes", fields: [studentId], references: [id], onDelete: Cascade)
  kind            String  @default("note")
  sharedWithAdmin Boolean @default(false)

  requests CalendarRequest[]

  @@index([tutorId])
  @@index([studentId])
  @@map("calendar_notes")
}

model CalendarRequest {
  id          String   @id @default(cuid())
  noteId      String?
  studentId   String
  studentName String
  message     String   @db.Text
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Extended request types (Phase 7) ──────────────────────────
  // requestType: 'move' (change date of existing note)
  //            | 'new'  (request new tutoring session — noteId null)
  //            | 'cancel' (request to cancel)
  // proposedDate / proposedTitle: hints used when approving 'move' or 'new'
  // tutorId:    addressee — the tutor who owns/will own the session
  requestType   String  @default("move")
  proposedDate  String?
  proposedTitle String?
  tutorId       String?

  note    CalendarNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student User          @relation("CalendarRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("calendar_requests")
}

model ParentAccess {
  id        String   @id @default(cuid())
  pin       String   @unique
  studentId String
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  student User @relation("ParentAccess", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("parent_access")
}

model TutorRequest {
  id        String   @id @default(cuid())
  tutorId   String
  studentId String
  status    String   @default("pending")
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor   User @relation("TutorRequests",  fields: [tutorId],   references: [id], onDelete: Cascade)
  student User @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId])
  @@map("tutor_requests")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum Subject {
  MATHEMATICS
  PHYSICAL_SCIENCES
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// v2.9 — review pipeline. Only PUBLISHED questions are pulled into Packs.
enum QuestionStatus {
  DRAFT       // freshly created, not yet checked
  REVIEW      // generated/imported in bulk, awaiting human sign-off
  PUBLISHED   // validated + approved — eligible for Packs & Assignments
  RETIRED     // pulled from circulation (kept for historical results)
}

enum Visibility {
  ALL
  GR10
  GR11
  GR12
  NONE
}

enum ResultType {
  ASSIGNMENT
  PRACTICE
}

// ─── Phase 1: Sharing & Content Packs ─────────────────────────────

model Pack {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  subject     Subject
  grade       Int
  topic       String?
  coverEmoji  String   @default("📦")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("PackCreator", fields: [createdById], references: [id])
  createdById String

  questions PackQuestion[]
  documents PackDocument[]
  shares    PackShare[]
  unlocks   StudentUnlock[]

  @@map("packs")
}

model PackQuestion {
  pack       Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId     String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  order      Int      @default(0)

  @@id([packId, questionId])
  @@map("pack_questions")
}

model PackDocument {
  pack       Pack        @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId     String
  document   PdfDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  order      Int         @default(0)

  @@id([packId, documentId])
  @@map("pack_documents")
}

model PackShare {
  id         String   @id @default(cuid())
  packId     String
  tutorId    String
  sharedById String
  note       String?  @db.Text
  sharedAt   DateTime @default(now())

  pack     Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  tutor    User @relation("TutorShares", fields: [tutorId], references: [id], onDelete: Cascade)
  sharedBy User @relation("PackSharedBy", fields: [sharedById], references: [id])

  @@unique([packId, tutorId])
  @@map("pack_shares")
}

model StudentUnlock {
  id           String   @id @default(cuid())
  studentId    String
  packId       String
  unlockedById String
  unlockedAt   DateTime @default(now())

  student    User @relation("StudentUnlocks", fields: [studentId], references: [id], onDelete: Cascade)
  pack       Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  unlockedBy User @relation("UnlockedBy", fields: [unlockedById], references: [id])

  @@unique([studentId, packId])
  @@map("student_unlocks")
}

// ─── Phase 2: PDF Documents ───────────────────────────────────────

model PdfDocument {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  filePath      String
  fileSize      Int      @default(0)
  pageCount     Int      @default(0)
  extractedText String?  @db.Text
  documentKind  String   @default("practice") // practice | test | notes
  uploadedById  String
  createdAt     DateTime @default(now())

  uploadedBy User           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  packs      PackDocument[]

  @@map("pdf_documents")
}

// ─── Phase 4: Notifications ───────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // pack_shared | pack_unlocked | assignment_new | tutor_approved | tutor_denied | result_posted | due_soon
  title     String
  body      String?   @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Phase 9: Generation batch history ────────────────────────────
// Every "⚡ Generate" click on the wizard creates one of these so tutors/admins
// can find what they generated again — re-bundle into a Pack, re-share, etc.

model QuestionBatch {
  id            String   @id @default(cuid())
  createdById   String
  subject       Subject
  grade         Int
  topic         String
  requestedCount Int     @default(0)
  difficulty    String?  // 'MIXED' / 'EASY' / 'MEDIUM' / 'HARD' — the wizard's mix selector
  note          String?  @db.Text
  // v2.9 — review state for the whole run: REVIEW → APPROVED (or DISCARDED)
  status        String   @default("REVIEW")
  createdAt     DateTime @default(now())

  createdBy User             @relation("BatchCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items     QuestionBatchItem[]

  @@index([createdById, createdAt])
  @@map("question_batches")
}

model QuestionBatchItem {
  batchId    String
  questionId String
  order      Int    @default(0)

  batch    QuestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  question Question      @relation("BatchedQuestions", fields: [questionId], references: [id], onDelete: Cascade)

  @@id([batchId, questionId])
  @@map("question_batch_items")
}

// ─── Phase 9: Audit log ───────────────────────────────────────────
// Admin can answer "who changed X and when?" — pivotal for trust + dispute resolution

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null if the system performed the action
  action     String   // e.g. user.create · pack.share · tutorRequest.approve
  entityType String   // 'User' · 'Pack' · 'TutorRequest' · ...
  entityId   String?
  meta       Json?    // arbitrary JSON: { before: ..., after: ..., target: ... }
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Phase 5: Onboarding ──────────────────────────────────────────

model OnboardingState {
  id             String   @id @default(cuid())
  userId         String   @unique
  completedSteps String[]
  dismissed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation("Onboarding", fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}
